// invert.comp — inverts pixel values (255 - pixel) on the GPU.
// Simplest possible GPU compute shader for image processing.

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint total_bytes;   // width * height * channels
} pc;

layout(std430, set = 0, binding = 0) readonly buffer InputFrame {
    uint data[];
} input_buf;

layout(std430, set = 0, binding = 1) writeonly buffer OutputFrame {
    uint data[];
} output_buf;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint word_count = (pc.total_bytes + 3u) >> 2u;
    if (idx >= word_count) return;

    // invert all 4 bytes in a uint32 at once: ~pixel = 0xFF - pixel for each byte
    output_buf.data[idx] = ~input_buf.data[idx];
}
